{
  "name": "@blazingagents/sdk",
  "version": "0.53.0",
  "description": "TypeScript SDK for the Blazing Agents API",
  "homepage": "https://docs.blazingagents.com",
  "bugs": {
    "url": "https://github.com/blazingagents/typescript-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazingagents/typescript-sdk.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "bundle-size": "node scripts/check-bundle-size.ts",
    "check": "npm run typecheck && npm run test && npm run bundle-size && npm run lint && npm run unused",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "prepack": "npm run build",
    "test": "node scripts/check-test-imports.ts && vitest run --coverage",
    "test:consumer": "node test-consumer.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "unused": "knip && knip --production --include exports,types,duplicates"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/react": "^16.3.3",
    "@types/json-schema": "7.0.15",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "ai": "^7.0.84",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.6",
    "knip": "^6.41.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.2",
    "vitest": "^4.1.10",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "ai": "^7.0.84",
    "react": "^18 || ^19",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
